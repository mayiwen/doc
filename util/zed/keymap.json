// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "alt-a": "project_panel::ToggleFocus",
      "alt-s": "git_panel::ToggleFocus",
      "alt-space": "workspace::ToggleLeftDock",
      "alt-g": "outline_panel::ToggleFocus",

      "alt-f": "editor::ViewBookmarks",
      // 鼠标前侧键 → 第一个标签
      "alt-j": ["pane::ActivateItem", 0],
      // 鼠标后侧键 → 第二个标签g
      "alt-k": ["pane::ActivateItem", 1],
    },
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      // "j k": "vim::SwitchToNormalMode"
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-'": "editor::ToggleComments",
      "alt-delete": "pane::CloseOtherItems",
      "alt-q": "pane::CloseOtherItems",
      "alt-c": "editor::DuplicateLineDown",
      "ctrl-w": "editor::SelectLargerSyntaxNode",
      "ctrl-q": "editor::SelectSmallerSyntaxNode",
      "alt-v": "editor::DeleteLine",
      "alt-e": "editor::MoveLineUp",
      "alt-r": "editor::MoveLineDown",
      "alt-d": "editor::ToggleBookmark",
      // 一键 添加/删除 书签
      "alt-x": [
        "workspace::SendKeystrokes",
        "ctrl-c ctrl-p right right right right right right right right right right ctrl-v enter",
      ],
      "alt-z": "editor::CopyFileLocation",
    },
  },
]
