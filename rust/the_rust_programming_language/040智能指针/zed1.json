{
  "title": "Zed‑Option修复：Alt‑字母绕过输入法",
  "rules": [
    {
      "description": "仅Zed前台，option+字母重新投递按键事件，避开IME死键",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": ["option"],
              "optional": ["shift","control","command"]
            }
          },
          "to": [{"key_code":"a","modifiers":["option"]}],
          "conditions": [{"type":"front_application_if","bundle_identifiers":["^dev.zed.Zed$"]}]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": ["option"],
              "optional": ["shift","control","command"]
            }
